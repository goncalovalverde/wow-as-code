{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WoW File Frontmatter",
  "description": "Schema for Ways of Working as Code file frontmatter (YAML)",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "enforcement",
    "owner",
    "applies_to"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for this WoW rule. Kebab-case. Used for inheritance matching across levels.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "description": "Human-readable title of the WoW rule."
    },
    "category": {
      "type": "string",
      "description": "Fixed category for grouping.",
      "enum": [
        "quality",
        "architecture",
        "delivery",
        "collaboration"
      ]
    },
    "enforcement": {
      "type": "string",
      "description": "How agents should treat this rule. 'hard' = block/warn (cannot be relaxed by lower levels). 'soft' = suggest (can be overridden). 'info' = reference only.",
      "enum": [
        "hard",
        "soft",
        "info"
      ]
    },
    "owner": {
      "type": "string",
      "description": "Team or person responsible for this rule. Use @ handle or team name."
    },
    "applies_to": {
      "type": "array",
      "description": "Triggers that determine when an agent should load this rule.",
      "items": {
        "type": "string",
        "enum": [
          "pr",
          "commit",
          "code-generation",
          "onboarding",
          "planning",
          "retrospective",
          "deploy"
        ]
      },
      "minItems": 1
    },
    "last_reviewed": {
      "type": "string",
      "description": "ISO 8601 date when this rule was last reviewed by the owner.",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "description": "Cross-cutting concerns that don't fit into a single category.",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string",
      "description": "Why this rule exists. Surfaced to agents and humans so rules stay self-documenting and can be challenged."
    },
    "review_by": {
      "type": "string",
      "description": "ISO 8601 date by which this rule must be reviewed again. Past this date the rule is considered stale.",
      "format": "date"
    },
    "verify": {
      "description": "How compliance with this rule is verified. 'hard' rules must use a deterministic or human verifier; an llm verifier is advisory only.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "check",
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "deterministic"
            },
            "check": {
              "enum": [
                "file-exists",
                "file-absent"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Path relative to the repository root."
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "check",
            "glob",
            "mode"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "deterministic"
            },
            "check": {
              "const": "pattern"
            },
            "glob": {
              "type": "string",
              "minLength": 1
            },
            "contains": {
              "type": "string",
              "minLength": 1
            },
            "regex": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "mode": {
              "enum": [
                "forbid",
                "require"
              ]
            }
          },
          "oneOf": [
            {
              "required": [
                "contains"
              ]
            },
            {
              "required": [
                "regex"
              ]
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "type",
            "check",
            "argv"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "deterministic"
            },
            "check": {
              "const": "command"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Executable and arguments; no shell. Runs only for local rules with --allow-commands."
            },
            "expect_exit": {
              "type": "integer",
              "default": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "instructions"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "human"
            },
            "instructions": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "prompt"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "llm"
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "enforcement": {
            "const": "hard"
          }
        },
        "required": [
          "enforcement"
        ]
      },
      "then": {
        "properties": {
          "verify": {
            "not": {
              "properties": {
                "type": {
                  "const": "llm"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            }
          }
        }
      }
    }
  ]
}
